# SACO ERP — production environment
# Copy on VPS: cp saco/env.example saco.env && nano saco.env
#
# App + deploy repo: saco_erp (app baked into Docker image at build time).
#
# Deploy (run from frappe_docker repo root):
#
#   ENV_FILE=saco.env bash ~/saco_erp/update-app.sh

ERPNEXT_VERSION=v16.27.0
FRAPPE_VERSION=v16.27.0

# Custom image (built with saco/apps.json + images/saco/Containerfile)
CUSTOM_IMAGE=saco-erpnext
CUSTOM_TAG=16

# Site name for bench commands — must match new-site name.
# Browser: http://VPS_IP:8082
FRAPPE_SITE_NAME_HEADER="YOUR_VPS_IP"
COMPOSE_PROJECT_NAME=saco

# Database — change before deploy (must differ from hamza / looms if on same VPS)
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Pull policy
PULL_POLICY=missing

# HTTP only — 8082 avoids hamza (8080) and looms (8081) on the same VPS
HTTP_PUBLISH_PORT=8082

# Paths used by update-app.sh (defaults work when frappe_docker is cloned to ~/hamza-enterprises-ERP-NEXT)
FRAPPE_DOCKER_ROOT=~/hamza-enterprises-ERP-NEXT
# VPS: /opt/saco/docker-compose.yml  |  Local Mac: ~/saco_erp/docker-compose.yml
COMPOSE_FILE=~/saco_erp/docker-compose.yml
