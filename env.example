# SACO ERP — production environment
# Copy on VPS: cp saco/env.example saco.env && nano saco.env
#
# App source: saco_erp on GitHub (cloned at Docker build — do not clone saco_erp on VPS).
#
# Deploy (run from frappe_docker repo root):
#
#   bash saco/update-app.sh

ERPNEXT_VERSION=v16.27.0
FRAPPE_VERSION=v16.27.0

# Custom image (built with apps.json + images/saco/Containerfile)
CUSTOM_IMAGE=saco-erpnext
CUSTOM_TAG=16

# Site name for bench commands — must match new-site name.
# Browser: http://VPS_IP:8080
FRAPPE_SITE_NAME_HEADER="YOUR_VPS_IP"
COMPOSE_PROJECT_NAME=saco

# Database — change before deploy
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Pull policy
PULL_POLICY=missing

# Dedicated SACO VPS: 8080. Use 8082 only if Hamza (8080) / Looms (8081) share the same host.
HTTP_PUBLISH_PORT=8080

COMPOSE_FILE=/opt/saco/docker-compose.yml
